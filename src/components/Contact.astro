---
import '../styles/Contact.css';
---

<section id="contact">
  <h2 class="contact-title">Contactez moi !</h2>

  <div class="contact-info">
    <div class="contact-item">
      <div class="contact-icon">☎</div>
      <div>
        <h3>Contactez moi par téléphone</h3>
        <a href="0770258778">07 23 45 67 89</a>
      </div>
    </div>

    <div class="contact-item">
      <div class="contact-icon">✉</div>
      <div>
        <h3>Envoyez moi un email</h3>
        <a href="Contact@Rtpp.Fr">Contact@Rtpp.Fr</a>
      </div>
    </div>

    <div class="socials">
      <a href="#" aria-label="Twitter">X</a>
      <a href="#" aria-label="LinkedIn">Ld</a>
      <a href="#" aria-label="Instagram">◎</a>
      <a href="#" aria-label="Facebook">f</a>
    </div>
  </div>

  <div class="contact-form-wrapper">
    <form class="contact-form">
      <h3>Laissez moi un message</h3>

      <input type="text" placeholder="NOM PRÉNOM" />
      <input type="tel" placeholder="TÉLÉPHONE" />
      <input type="email" placeholder="EMAIL" />
      <textarea placeholder="MESSAGE"></textarea>

      <button type="submit">SUBMIT</button>
    </form>
  </div>
</section>

