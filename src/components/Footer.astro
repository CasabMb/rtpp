            <a href="#contact">Contact</a>
        </nav> 

        <div class="footer-line"></div>

        <div class="footer-bottom">
            <div class="footer-legal">
                <a href="#">Mentions légales</a>
                <span>|</span>
                <a href="#">Politique de confidentialité</a>
                <span>|</span>
            </div>

        <p>© RTPP 2026. Tout droit réservé</p>
        </div>
    </div>
</footer>
